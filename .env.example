# Names only. Real values live in Cloud Run environment variables and Secret Manager (project sova-production). Never commit values.
TOKEN=                 # guards the job routes; signs customer links; derives the webhook, purchase and insights keys
BRIZA_API_KEY=         # Briza send-template API key (tied to the WhatsApp sender number)
REDCLIFFE_KEY=         # Redcliffe API key (staging)
REDCLIFFE_HOST=        # Redcliffe API host (staging by default)
MAPS_KEY=              # Google Maps key for the booking page's address pin
DASH_USERS=            # bootstrap dashboard login(s)
DASH_PASSWORD=         # bootstrap dashboard password
PROJECT=sova-production
DATASET=sova-production.sova

# Secret Manager (saved from the Settings page): bt-redcliffe-prod-key, bt-shopify-in-app, bt-shopify-health-app,
# adh-shopify-access-token, adh-shopify-health-token
